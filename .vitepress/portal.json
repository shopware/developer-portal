{
  "root": "src",
  "repositories": [
    {
      "name": "shopware/docs",
      "src": ".",
      "dst": "docs",
      "branch": [
        "env.BRANCH_DOCS",
        "main"
      ],
      "org": [
        "env.ORG_DOCS",
        "shopware"
      ]
    },
    {
      "name": "shopware/docs",
      "src": ".",
      "dst": [
        "docs",
        "v6.6"
      ],
      "branch": [
        "env.BRANCH_DOCS_66",
        "v6.6"
      ],
      "org": [
        "env.ORG_DOCS_66",
        "shopware"
      ]
    },
    {
      "name": "shopware/docs",
      "src": ".",
      "dst": [
        "docs",
        "v6.5"
      ],
      "branch": [
        "env.BRANCH_DOCS_65",
        "v6.5"
      ],
      "org": [
        "env.ORG_DOCS_65",
        "shopware"
      ]
    },
    {
      "name": "shopware/frontends",
